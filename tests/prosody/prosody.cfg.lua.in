-- 仅用于本地自动化测试的 Prosody 配置（无 TLS，监听 127.0.0.1）
-- 用法：tests/prosody/run.sh（会把 @RUN@ 替换成运行目录）
data_path = "@RUN@/data"
pidfile = "@RUN@/prosody.pid"
log = { info = "@RUN@/prosody.log" }
daemonize = false
interfaces = { "127.0.0.1" }
c2s_ports = { 15222 }
s2s_ports = {}
c2s_require_encryption = false
allow_unencrypted_plain_auth = true
authentication = "internal_hashed"
modules_enabled = { "roster", "saslauth", "disco", "carbons", "pep", "private", "blocklist",
  "vcard_legacy", "version", "uptime", "time", "ping", "register", "mam", "smacks", "posix" }
modules_disabled = { "s2s", "tls" }
allow_registration = false
VirtualHost "test.local"
Component "conference.test.local" "muc"
  modules_enabled = { "muc_mam" }
